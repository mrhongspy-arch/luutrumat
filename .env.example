# Token lấy từ @BotFather
BOT_TOKEN=123456789:ABC-your-token
# ID Telegram của admin (lấy từ @userinfobot), nhiều ID cách nhau bằng dấu phẩy
ADMIN_IDS=123456789
# Thông tin chuyển khoản (dùng để tạo mã QR VietQR)
BANK_CODE=MB
BANK_ACCOUNT=0123456789
BANK_ACCOUNT_NAME=NGUYEN VAN A
# Tiền tố nội dung chuyển khoản, ví dụ: DH12AB34
ORDER_PREFIX=DH
# Đơn chưa thanh toán sẽ tự huỷ sau số phút này
ORDER_TIMEOUT_MINUTES=30
SUPPORT_CONTACT=@your_support
DB_PATH=shop.db
# Tự gửi thông báo "có hàng lại" cho khách khi nạp kho cho sản phẩm đang hết hàng
AUTO_RESTOCK_NOTIFY=true
# (Tuỳ chọn) Kênh Telegram để đăng thông báo, ví dụ @kenhcuashop (bot phải là admin của kênh)
CHANNEL_ID=
# Trang quản trị web: đặt mật khẩu (ít nhất 8 ký tự) để bật, mở http://localhost:8080/admin
ADMIN_PASSWORD=
WEB_PORT=8080
# (Tuỳ chọn) Webhook ngân hàng (SePay/Casso) để tự xác nhận thanh toán
WEBHOOK_ENABLED=false
WEBHOOK_SECRET=change-me
